# ═══════════════════════════════════════════════════════════════════
# ENTORNO DE LABORATORIO — copiar a .env  (cp .env.lab.example .env)
#
# Todo apunta a servicios LOCALES o de PRUEBA. Ninguna variable aquí
# debe tocar producción. Si copias un valor de Railway a este archivo,
# rompiste el aislamiento.
# ═══════════════════════════════════════════════════════════════════

# ── Base de datos: contenedor local del docker-compose.lab.yml ──
DATABASE_URL=postgresql://maxidocs:lab-local-no-secreta@localhost:5433/maxi_docs_lab

PORT=3001
NODE_ENV=development

# ── URLs separadas (en prod hoy están mezcladas — ver docs/01-BUGS #18) ──
FRONTEND_PUBLIC_URL=http://localhost:8301
BACKEND_PUBLIC_URL=http://localhost:3001
# Compatibilidad con el código actual mientras se migra:
FRONTEND_URL=http://localhost:8301
PUBLIC_URL=http://localhost:8301
BACKEND_URL=http://localhost:3001

# ── Secretos de laboratorio — NO son los de producción ──
# Generar propios:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=lab-cambiar-por-uno-generado-localmente
APP_ENCRYPTION_KEY=lab-cambiar-por-uno-generado-localmente

# ── Monday ──
# DEJAR VACÍO por defecto. Con token real, el lab escribe en los boards
# reales de MAXIRent. Si necesitas probar la integración, crea un board
# de pruebas aparte y pon aquí SU id.
MONDAY_API_TOKEN=
MONDAY_SIGNING_SECRET=
MONDAY_CATALOG_BOARD_ID=
MONDAY_OPORTUNIDADES_BOARD_ID=

# ── Email: vacío = no se manda nada, solo se loguea. Es lo que queremos. ──
# Para probar correos de verdad sin arriesgar: usa mailpit o el modo test de Resend.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=MaxiDocs LAB <lab@localhost>
NOTIFY_EMAIL=

# ── Storage: vacío = filesystem local en uploads/ ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ── Opcionales ──
STRIPE_SECRET_KEY=
ANTHROPIC_API_KEY=
WEBHOOK_URL=

# ── Firma por defecto (% de la página) ──
SIGNATURE_X=5
SIGNATURE_Y=77
SIGNATURE_W=38
SIGNATURE_H=9
SIGNATURE_PAGE=1
